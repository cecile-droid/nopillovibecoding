---
import HeroPaidHeadline from '../HeroPaidHeadline.tsx'
import HeroSimForm from '../HeroSimForm.tsx'
---
<section class="hero-paid">
  <div class="hero-paid-container">
    <div class="hero-paid-block">
      <!-- Courbe ondulee decorative (inspiration draft 1 "Simulateur V2") -->
      <svg class="hero-paid-waves" viewBox="0 0 1200 700" fill="none" aria-hidden="true" preserveAspectRatio="xMaxYMid slice">
        <path d="M-40 560 C 240 460 360 660 640 540 S 1020 420 1280 520" stroke="#FFFFFF" stroke-opacity="0.55" stroke-width="2" />
        <path d="M120 660 C 360 540 520 740 760 600 S 1100 500 1320 600" stroke="#8275FF" stroke-opacity="0.25" stroke-width="2" />
        <path d="M700 -60 C 900 120 760 320 980 420 S 1240 520 1360 460" stroke="#FFFFFF" stroke-opacity="0.5" stroke-width="2" />
      </svg>

      <div class="hero-paid-grid">
        <!-- Colonne gauche : titre + accroche + CTA + chips -->
        <div class="hero-paid-left">
          <HeroPaidHeadline client:load />

          <!-- Chips de reassurance (inspiration draft 1) -->
          <ul class="hero-paid-chips">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
              Gratuit
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Sans engagement
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              3 minutes
            </li>
          </ul>
        </div>

        <!-- Colonne droite : formulaire simulateur (capture lead -> HubSpot) -->
        <aside class="hero-paid-right" id="contact">
          <HeroSimForm client:load />
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-paid {
    background-color: var(--color-brand-white);
    padding: 16px 0 40px;
  }

  /* Container hero elargi -> moins de blanc sur les cotes */
  .hero-paid-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .hero-paid-block {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: rgba(222, 218, 255, 0.6); /* indigo-100 60% — fond hero */
    border-radius: 32px;
    padding: 20px 24px 32px;
  }

  @media (min-width: 1024px) {
    .hero-paid-block {
      padding: 24px 32px 28px;
    }
  }

  /* Courbes ondulees en fond, derriere le contenu */
  .hero-paid-waves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  /* Grid */
  .hero-paid-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: stretch;
  }

  /* Colonne gauche : texte centré verticalement face au formulaire */
  .hero-paid-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .hero-paid-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 56px;
    }
  }

  /* Chips de reassurance */
  .hero-paid-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .hero-paid-chips li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-brand-black);
  }
  .hero-paid-chips svg {
    color: var(--color-indigo-600, #4033DB);
  }
</style>
